# Copy to backend/.env for local development
DEBUG=True
SECRET_KEY=change-me
# DATABASE_URL=postgres://user:pass@localhost:5432/voltcart   (SQLite is used when unset)
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Stripe test keys from https://dashboard.stripe.com/test/apikeys (leave empty for cash on delivery only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Staff login created by `python manage.py ensure_admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
